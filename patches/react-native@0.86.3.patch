+// iOS counts the native module's listeners as soon as one is removed, while a
+// node stops sending updates only once the operation queue runs: removing the
+// listener first lets an update go out with none registered. So listeners are
+// removed together, once per batch, in the callback of a single getValue
+// queued after all of that batch's stops.
+let pendingRemovals: Array<EventSubscription> = [];
+let queueMark: ?AnimatedValue = null;
+function removeAfterQueuedStops(subscription: EventSubscription): void {
+  pendingRemovals.push(subscription);
+  if (pendingRemovals.length > 1) {
+    return;
+  }
+  queueMicrotask(() => {
+    const batch = pendingRemovals;
+    pendingRemovals = [];
+    if (queueMark == null) {
+      queueMark = new AnimatedValue(0, {useNativeDriver: true});
+    }
+    NativeAnimatedAPI.getValue(queueMark.__getNativeTag(), () => {
+      for (const removal of batch) {
+        removal.remove();
+      }
+    });
+  });
+}
